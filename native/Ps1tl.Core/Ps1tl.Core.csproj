<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Ps1tl</RootNamespace>
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>

  <ItemGroup>
    <!-- built-in pixel fonts -->
    <EmbeddedResource Include="fonts\*.txt" LogicalName="fonts.%(Filename).txt" />
    <!-- picture text read by hand (file, entry, Japanese, English) that a game's extract adds as lines -->
    <EmbeddedResource Include="seeds\*.json" LogicalName="seeds.%(Filename).json" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Anthropic" Version="12.53.0" />
  </ItemGroup>

</Project>
